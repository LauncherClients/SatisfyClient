div {
	display: block;
}

p {
	display: block;
}

h1 {
	display: block;
}

em {
	font-style: italic;
}

strong {
	font-weight: bold;
}

img {
	display: inline-block;
}

button {
	display: inline-block;
	tab-index: auto;
	box-sizing: border-box;
}

input {
	display: inline-block;
	tab-index: auto;
	box-sizing: border-box;
}

body {
	display: block;
}

handle {
	display: block;
}

select {
	text-align: left;
	tab-index: auto;
}

tabset tabs {
	display: block;
}

table {
	box-sizing: border-box;
	display: table;
}

tr {
	box-sizing: border-box;
	display: table-row;
}

td {
	box-sizing: border-box;
	display: table-cell;
}

col {
	box-sizing: border-box;
	display: table-column;
}

colgroup {
	display: table-column-group;
}

thead, tbody, tfoot {
	display: table-row-group;
}
