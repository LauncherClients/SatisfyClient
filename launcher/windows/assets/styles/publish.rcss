body {
	display: block;
	box-sizing: border-box;
	font-family: Roboto;
	font-weight: normal;
	font-size: 16dp;
	color: #e7eef8;
	background-color: #0b1018;
	width: 100%;
	height: 100%;
}

p {
	display: block;
	margin: 0;
}

button {
	display: inline-block;
	box-sizing: border-box;
	tab-index: auto;
	border-width: 0;
	background-color: #1d2633;
	color: #e7eef8;
	font-family: Roboto;
	font-size: 15dp;
	font-weight: bold;
	padding: 10dp 16dp;
}

button:hover {
	background-color: #2a3648;
}

#app {
	width: 100%;
	height: 100%;
	padding: 28dp 32dp;
	box-sizing: border-box;
}

#title {
	font-size: 26dp;
	font-weight: bold;
	color: #ffffff;
	margin-bottom: 10dp;
}

#blurb {
	color: #a9b6c7;
	line-height: 1.4em;
	margin-bottom: 22dp;
}

.mono {
	color: #e6b822;
}

.label {
	font-size: 12dp;
	letter-spacing: 0.12em;
	color: #7d8ba1;
	margin-bottom: 6dp;
}

.folder-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 18dp;
}

.folder-path {
	flex: 1;
	background-color: #121a26;
	padding: 10dp 12dp;
	margin-right: 10dp;
	color: #c5d0de;
}

input {
	display: block;
	box-sizing: border-box;
	width: 240dp;
	height: 36dp;
	padding: 6dp 10dp;
	background-color: #121a26;
	color: #e7eef8;
	border-width: 1dp;
	border-color: #3d4c63;
	font-family: Roboto;
	font-size: 15dp;
	margin-bottom: 18dp;
}

#status {
	color: #9fd7ff;
	min-height: 40dp;
	margin-bottom: 12dp;
	line-height: 1.4em;
}

#progress {
	display: block;
	margin-bottom: 18dp;
}

#progress-text {
	color: #e6b822;
	font-size: 14dp;
	margin-bottom: 6dp;
}

#bar-track {
	width: 100%;
	height: 16dp;
	background-color: #121a26;
	border-width: 1dp;
	border-color: #3d4c63;
}

#bar-fill {
	height: 16dp;
	width: 0%;
	background-color: #e6b822;
}

#actions {
	display: flex;
	flex-direction: row;
	justify-content: flex-end;
}

.btn {
	min-width: 120dp;
	margin-left: 10dp;
	font-weight: bold;
	text-align: center;
}

.btn.play {
	background-color: #e6b822;
	color: #061018;
}

.btn.play:hover {
	background-color: #f2af0d;
}

.btn.ghost {
	background-color: transparent;
	border-width: 1dp;
	border-color: #3d4c63;
}

.btn.disabled {
	color: #686868;
	background-color: #3a4452;
}
