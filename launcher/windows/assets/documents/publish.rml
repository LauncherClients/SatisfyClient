<rml>
<head>
	<title>Publish client manifest</title>
	<link type="text/rcss" href="../styles/rml.rcss"/>
	<link type="text/rcss" href="../styles/publish.rcss"/>
</head>
<body data-model="publisher">
	<div id="app">
		<p id="title">Publish client manifest</p>
		<p id="blurb">Hash the release client folder and write <span class="mono">{{ output_name }}</span>. Save it in the same folder, or pick another target folder.</p>

		<p class="label">Client folder</p>
		<div class="folder-row">
			<p class="folder-path">{{ folder_path }}</p>
			<button id="btn-browse" class="btn" data-class-disabled="busy">Browse</button>
		</div>

		<p class="label">Save manifest to</p>
		<div class="folder-row">
			<p class="folder-path">{{ output_path }}</p>
			<button id="btn-same-folder" class="btn ghost" data-class-disabled="busy">Same folder</button>
			<button id="btn-browse-output" class="btn" data-class-disabled="busy">Browse</button>
		</div>

		<p class="label">Manifest version</p>
		<input id="version" type="text" data-value="version"/>

		<p id="status">{{ status }}</p>
		<div id="progress" data-if="show_progress">
			<p id="progress-text">{{ progress_text }}</p>
			<div id="bar-track">
				<div id="bar-fill" data-attr-style="progress_style"></div>
			</div>
		</div>

		<div id="actions">
			<button id="btn-generate" class="btn play" data-class-disabled="generate_disabled">Generate</button>
			<button id="btn-quit" class="btn ghost">Close</button>
		</div>
	</div>
</body>
</rml>
